#!/usr/bin/env python3
"""Nagios notification command: posts the alert to the on-call inbox as JSON."""
import json
import sys
import time
import urllib.request

kind, host, service, state, output = (sys.argv[1:] + [''] * 5)[:5]
body = json.dumps({'type': kind, 'host': host, 'service': service, 'state': state,
                   'output': output, 'at': time.time()}).encode()
req = urllib.request.Request('http://10.43.0.20:8080/alert', body, {'Content-Type': 'application/json'})
urllib.request.urlopen(req, timeout=5)
